NODE_ENV=development
PORT=3000

DB_PORT=5433            # host port for docker-compose PostGIS; keep in sync with DATABASE_URL
DATABASE_URL=postgres://aqar:aqar@localhost:5433/aqar
DATABASE_URL_TEST=postgres://aqar:aqar@localhost:5433/aqar_test   # npm run test:db only; never the dev/prod database
# Auth (required: the server refuses to start without them). 32 random bytes each, base64, different from each other.
# JWT_SECRET signs access tokens; REFRESH_TOKEN_SECRET keys the stored refresh-token and IP hashes.
# Changing either logs everyone out.
JWT_SECRET=
REFRESH_TOKEN_SECRET=
# Phone encryption (AES-256-GCM) and lookup hash (HMAC-SHA256): 32 random bytes each, base64.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use different keys per environment; losing ENCRYPTION_KEY makes stored phones unreadable.
ENCRYPTION_KEY=
PHONE_HASH_KEY=
# Basemap styles (free, no API key). Empty = OpenFreeMap dark / positron.
MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
# Public origin: CSRF origin check; https enables Secure/__Host- cookies. Production: https://<your domain>
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# Listing submissions allowed per user per rolling 24 h (default 10).
SUBMISSIONS_PER_DAY=10
# Operating company's legal details: shown in the footer and on invoices. All required in production
# (the server refuses to start without them); optional in development.
COMPANY_LEGAL_NAME_AR=
COMPANY_LEGAL_NAME_EN=
COMPANY_CR_NUMBER=            # commercial registration number
COMPANY_TAX_NUMBER=           # tax identification number (digits)
COMPANY_SALES_TAX_REGISTERED= # true / false — registered for general sales tax (commission invoices add the tax)
COMPANY_DLS_LICENSE_NUMBER=   # Department of Lands and Survey real-estate office licence number
