{
  "name": "aqar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "db:rollback": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "db:seed": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run",
    "lint": "eslint .",
    "db:import-boundaries": "tsx scripts/import-boundaries.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@react-router/express": "~7.18.7",
    "@react-router/node": "~7.18.7",
    "compression": "^1.8.2",
    "cookie": "^2.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "isbot": "^5.2.4",
    "jose": "^6.2.18",
    "knex": "^3.3.0",
    "lucide-react": "^1.83.0",
    "maplibre-gl": "^6.19.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "rate-limiter-flexible": "^11.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "~7.18.7",
    "sharp": "^0.35.5",
    "terra-draw": "^1.40.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "~7.18.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "supertest": "^7.3.2",
    "tailwind-csstree": "^0.4.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
