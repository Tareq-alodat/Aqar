{
  "name": "aqar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "db:rollback": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "db:seed": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@react-router/express": "~7.18.7",
    "@react-router/node": "~7.18.7",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "isbot": "^5.2.4",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "~7.18.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "~7.18.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "supertest": "^7.3.2",
    "tailwind-csstree": "^0.4.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
